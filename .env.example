# ═══════════════════════════════════════════════
# VestiNex Environment Configuration
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════

# ── Database ──────────────────────────────────
POSTGRES_USER=vestinex
POSTGRES_PASSWORD=vestinex_dev_password
POSTGRES_DB=vestinex_db
DATABASE_URL=postgresql://vestinex:vestinex_dev_password@localhost:5432/vestinex_db?schema=public

# ── Backend ───────────────────────────────────
PORT=4000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-random-64-char-string-in-production
FRONTEND_URL=http://localhost:3000

# ── Frontend ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── GitHub Integrations (Optional) ────────────
# Optional GitHub Personal Access Token for higher API rate limits (60/hr -> 5,000/hr)
# GITHUB_TOKEN=ghp_your_token_here
# Webhook secret configured in GitHub repository webhook settings
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here
