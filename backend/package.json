{
  "name": "vestinex-backend",
  "version": "1.0.0",
  "description": "VestiNex Backend API - Incident Intelligence & Deployment Monitoring",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate --schema=../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=../prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=../prisma/schema.prisma",
    "prisma:seed": "tsx src/scripts/seed.ts",
    "persistence:verify": "tsx src/scripts/verify-persistence.ts",
    "persistence:restart": "tsx src/scripts/test-live-restart-persistence.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@prisma/client": "^5.22.0",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "pg": "^8.23.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
